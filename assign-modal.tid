title: $:/plugins/rimir/kind-streams/assign-modal
tags: $:/tags/AboveStory
type: text/vnd.tiddlywiki

\whitespace trim
\import $:/plugins/rimir/kind/engine

<!-- Assign / change / remove the kind.type of a stream node. Opened from the
     Streams right-click context menu ("Kind type…"), which writes the node
     title into $:/state/rimir/kind-streams/assign. Rendered ONCE globally
     (AboveStory) — zero per-node cost. Reuses kind's type-picker, which does
     all the set/change/remove work; it just needs target-tid in scope. -->

<$list filter="[[$:/state/rimir/kind-streams/assign]get[text]!is[blank]]" variable="ks-node">
<$let target-tid=<<ks-node>>>
<div class="ks-modal-backdrop">
<div class="ks-modal-panel">
<div class="ks-modal-header">
Kind type — <strong><$text text={{{ [<ks-node>get[caption]!is[blank]] ~[<ks-node>] }}}/></strong>
<$button class="tc-btn-invisible ks-modal-close" tooltip="Close">
<$action-deletetiddler $tiddler="$:/state/rimir/kind-streams/assign"/>
✕
</$button>
</div>
<div class="ks-modal-body">
<$transclude $tiddler="$:/plugins/rimir/kind/type-picker"/>
</div>
<div class="ks-modal-footer">
<$button class="ks-modal-done">
<$action-deletetiddler $tiddler="$:/state/rimir/kind-streams/assign"/>
Done
</$button>
</div>
</div>
</div>
</$let>
</$list>
